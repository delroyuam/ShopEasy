@model IEnumerable<ShopEasyMVC.Models.OrderItem>

@{
    ViewData["Title"] = "Detalles de órdenes";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Detalles de Órdenes
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Administración de productos asociados a las órdenes del sistema.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary shadow-sm px-4 rounded-pill fw-semibold">
            <span class="me-1">+</span>
            Agregar Producto a Orden
        </a>

    </div>


    <!-- TABLA PRINCIPAL -->
    <div class="card enterprise-card">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <!-- SIN RESULTADOS -->
                <div class="empty-state">

                    <div class="empty-state-icon">
                        📋
                    </div>

                    <h5 class="fw-bold empty-state-title">
                        No se encontraron detalles de orden
                    </h5>

                    <p class="empty-state-text mb-3">
                        Aún no existen productos asociados a órdenes en el sistema.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        Agregar producto a orden
                    </a>

                </div>
            }
            else
            {
                <!-- INFORMACIÓN DE RESULTADOS -->
                <div class="inventory-table-header">

                    <div>
                        <h2 class="h6 fw-bold mb-1 section-title">
                            Productos en órdenes
                        </h2>

                        <p class="small mb-0 section-subtitle">
                            @Model.Count() registro(s) encontrado(s).
                        </p>
                    </div>

                </div>


                <!-- TABLA -->
                <div class="table-responsive">

                    <table class="table enterprise-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th class="ps-4">
                                    Orden
                                </th>

                                <th>
                                    Producto
                                </th>

                                <th>
                                    Cantidad
                                </th>

                                <th>
                                    Precio unitario
                                </th>

                                <th class="text-end pe-4">
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- ORDEN -->
                                    <td class="ps-4">

                                        <div class="product-name">
                                            @item.Order.OrderNumber
                                        </div>

                                    </td>


                                    <!-- PRODUCTO -->
                                    <td>

                                        <span class="product-category">
                                            @item.Product.Name
                                        </span>

                                    </td>


                                    <!-- CANTIDAD -->
                                    <td>

                                        <span class="stock-value">
                                            @Html.DisplayFor(modelItem => item.Quantity)
                                        </span>

                                    </td>


                                    <!-- PRECIO UNITARIO -->
                                    <td>

                                        <span class="product-price">
                                            @item.UnitPrice.ToColones()
                                        </span>

                                    </td>


                                    <!-- ACCIONES -->
                                    <td class="text-end pe-4">

                                        <div class="dropdown">

                                            <button class="btn btn-sm action-button"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    aria-label="Acciones">

                                                <span>•••</span>

                                            </button>


                                            <ul class="dropdown-menu dropdown-menu-end enterprise-dropdown">

                                                <li>

                                                    <a class="dropdown-item enterprise-dropdown-item"
                                                       asp-action="Details"
                                                       asp-route-id="@item.Id">

                                                        <span class="action-icon action-info">
                                                            📄
                                                        </span>

                                                        Ver detalles

                                                    </a>

                                                </li>


                                                <li>

                                                    <a class="dropdown-item enterprise-dropdown-item"
                                                       asp-action="Edit"
                                                       asp-route-id="@item.Id">

                                                        <span class="action-icon action-warning">
                                                            ✏️
                                                        </span>

                                                        Editar

                                                    </a>

                                                </li>


                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>


                                                <li>

                                                    <a class="dropdown-item enterprise-dropdown-item text-danger"
                                                       asp-action="Delete"
                                                       asp-route-id="@item.Id">

                                                        <span class="action-icon action-danger">
                                                            🗑️
                                                        </span>

                                                        Eliminar

                                                    </a>

                                                </li>

                                            </ul>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>