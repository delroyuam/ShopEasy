@model ShopEasyMVC.Models.User

@{
    ViewData["Title"] = "Eliminar usuario";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Eliminar Usuario
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Confirma la eliminación del usuario seleccionado.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
            Volver
        </a>

    </div>


    <!-- CONFIRMACIÓN -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-3 mb-4 delete-warning-box">

                <div class="delete-warning-icon">
                    ⚠️
                </div>

                <div>
                    <h2 class="h6 fw-bold mb-1 section-title">
                        ¿Seguro que desea eliminar este usuario?
                    </h2>

                    <p class="small mb-0 section-subtitle">
                        Esta acción no se puede deshacer. El usuario será eliminado permanentemente del sistema.
                    </p>
                </div>

            </div>

            <!-- DETALLE DEL USUARIO -->
            <div class="delete-detail-box mb-4">

                <dl class="row mb-0">

                    <dt class="col-sm-3 enterprise-label mb-2">Nombre completo</dt>
                    <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.FullName)</dd>

                    <dt class="col-sm-3 enterprise-label mb-0">Correo</dt>
                    <dd class="col-sm-9 mb-0">@Html.DisplayFor(model => model.Email)</dd>

                </dl>

            </div>


            <!-- BOTONES -->
            <form asp-action="Delete" method="post" class="d-flex gap-2">

                <input type="hidden" asp-for="Id" />

                <input type="submit" value="Eliminar usuario" class="btn btn-danger fw-semibold px-4 rounded-pill" />

                <a asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 rounded-pill">
                    Cancelar
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <style>

        .delete-warning-box {
            padding: 1rem 1.25rem;
            background-color: rgba(220, 38, 38, 0.06);
            border: 1px solid rgba(220, 38, 38, 0.15);
            border-radius: 0.6rem;
        }

        .delete-warning-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: rgba(220, 38, 38, 0.1);
            font-size: 1.2rem;
        }

        .delete-detail-box {
            padding: 1.25rem;
            background-color: var(--ent-surface-alt);
            border: 1px solid var(--ent-border);
            border-radius: 0.6rem;
        }

            .delete-detail-box dt {
                color: var(--ent-text-muted);
                font-size: 0.82rem;
                font-weight: 600;
            }

            .delete-detail-box dd {
                color: var(--ent-text);
                font-size: 0.9rem;
                font-weight: 600;
            }

    </style>

}