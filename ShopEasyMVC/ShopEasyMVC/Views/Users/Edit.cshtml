@model ShopEasyMVC.Models.User

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Editar Usuario
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Modifica la información del usuario seleccionado.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
            Volver
        </a>

    </div>


    <!-- FORMULARIO -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div>
                    <h2 class="h6 fw-bold mb-1 section-title">
                        Información del usuario
                    </h2>

                    <p class="small mb-0 section-subtitle">
                        Actualiza los campos necesarios y guarda los cambios.
                    </p>
                </div>

            </div>

            <form asp-action="Edit" method="post" class="row g-3">

                <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
                <input type="hidden" asp-for="Id" />

                <!-- NOMBRE COMPLETO -->
                <div class="col-12 col-md-6">

                    <label asp-for="FullName" class="form-label enterprise-label">
                        Nombre completo
                    </label>

                    <input asp-for="FullName" class="form-control enterprise-input" />
                    <span asp-validation-for="FullName" class="text-danger"></span>

                </div>


                <!-- CORREO -->
                <div class="col-12 col-md-6">

                    <label asp-for="Email" class="form-label enterprise-label">
                        Correo
                    </label>

                    <div class="input-group">

                        <span class="input-group-text enterprise-input-icon">
                            ✉️
                        </span>

                        <input asp-for="Email" class="form-control enterprise-input" />

                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>


                <!-- ROL -->
                <div class="col-12 col-md-6">

                    <label for="roleName" class="form-label enterprise-label">
                        Rol
                    </label>

                    <select id="roleName" name="roleName" class="form-select enterprise-input" asp-items="ViewBag.RoleName">
                        <option value="">Seleccione un rol</option>
                    </select>
                    <span class="text-danger">@Html.ValidationMessage("roleName")</span>

                </div>


                <!-- BOTONES -->
                <div class="col-12 d-flex gap-2 mt-4">

                    <input type="submit" value="Guardar cambios" class="btn btn-primary fw-semibold px-4 rounded-pill" />

                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 rounded-pill">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}