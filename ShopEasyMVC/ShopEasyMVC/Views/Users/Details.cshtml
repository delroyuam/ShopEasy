@model ShopEasyMVC.Models.User

@{
    ViewData["Title"] = "Detalles del usuario";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Detalles del Usuario
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Información completa del usuario seleccionado.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary shadow-sm px-4 rounded-pill fw-semibold">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
                Volver
            </a>

        </div>

    </div>


    <!-- DETALLE -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <dl class="row product-detail-dl mb-0">

                <dt class="col-sm-3 enterprise-label mb-2">Nombre completo</dt>
                <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.FullName)</dd>

                <dt class="col-sm-3 enterprise-label mb-2">Correo</dt>
                <dd class="col-sm-9 mb-2">@Html.DisplayFor(model => model.Email)</dd>

                <dt class="col-sm-3 enterprise-label mb-2">Roles</dt>
                <dd class="col-sm-9 mb-2">@Model.UserRoles.Count</dd>

                <dt class="col-sm-3 enterprise-label mb-0">Órdenes</dt>
                <dd class="col-sm-9 mb-0">@Model.Orders.Count</dd>

            </dl>

        </div>

    </div>

</div>

@section Scripts {

    <style>

        .product-detail-dl dt {
            color: var(--ent-text-muted);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .product-detail-dl dd {
            color: var(--ent-text);
            font-size: 0.9rem;
            font-weight: 600;
        }

    </style>

}