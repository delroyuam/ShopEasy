@model ShopEasyMVC.Models.User

@{
    ViewData["Title"] = "Detalles del usuario";
}

<h1>Detalles del usuario</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre completo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FullName)</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">@Model.UserRoles.Count</dd>

        <dt class="col-sm-2">Órdenes</dt>
        <dd class="col-sm-10">@Model.Orders.Count</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
