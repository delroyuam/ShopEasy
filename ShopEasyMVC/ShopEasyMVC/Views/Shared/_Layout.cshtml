<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ShopEasyMVC</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ShopEasyMVC.styles.css"
          asp-append-version="true" />


    <style>

            /* =========================================================
                       ENTERPRISE DESIGN SYSTEM
                       ========================================================= */

            :root {
                /* Primary */
                --ent-primary: #2563EB;
                --ent-primary-dark: #1D4ED8;
                --ent-primary-light: #DBEAFE;
                /* Backgrounds */
                --ent-bg: #F8FAFC;
                --ent-surface: #FFFFFF;
                --ent-surface-alt: #F1F5F9;
                /* Text */
                --ent-text: #0F172A;
                --ent-text-muted: #475569;
                --ent-text-light: #94A3B8;
                /* Borders */
                --ent-border: #E2E8F0;
                /* Semantic states */
                --ent-success: #16A34A;
                --ent-warning: #D97706;
                --ent-danger: #DC2626;
                --ent-info: #0284C7;
                /* Sidebar */
                --ent-sidebar-bg: #0F172A;
                --ent-sidebar-text: #CBD5E1;
                --ent-sidebar-hover: #1E293B;
                /* Layout */
                --ent-sidebar-width: 260px;
                --ent-navbar-height: 70px;
            }


            /* =========================================================
                       GLOBAL
                       ========================================================= */

            html {
                font-size: 14px;
                min-height: 100%;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background-color: var(--ent-bg);
                color: var(--ent-text);
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            }


            h1,
            h2,
            h3,
            h4,
            h5,
            h6 {
                color: var(--ent-text);
                font-weight: 700;
            }


            a {
                text-decoration: none;
            }


            /* =========================================================
                       MAIN WRAPPER
                       ========================================================= */

            .enterprise-wrapper {
                display: flex;
                min-height: 100vh;
                width: 100%;
            }


            /* =========================================================
                       SIDEBAR
                       ========================================================= */

            .enterprise-sidebar {
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: var(--ent-sidebar-width);
                background-color: var(--ent-sidebar-bg);
                color: var(--ent-sidebar-text);
                overflow-y: auto;
                overflow-x: hidden;
                z-index: 1050;
                padding: 1rem;
                transition: transform 0.25s ease, width 0.25s ease;
            }


                /* Scrollbar */

                .enterprise-sidebar::-webkit-scrollbar {
                    width: 6px;
                }

                .enterprise-sidebar::-webkit-scrollbar-track {
                    background: transparent;
                }

                .enterprise-sidebar::-webkit-scrollbar-thumb {
                    background-color: #334155;
                    border-radius: 10px;
                }


            /* =========================================================
                       BRAND
                       ========================================================= */

            .enterprise-brand {
                display: flex;
                align-items: center;
                min-height: 45px;
                margin-bottom: 1.5rem;
                padding: 0.5rem 0.75rem;
                color: #FFFFFF;
                border-radius: 0.5rem;
                transition: background-color 0.2s ease;
            }

                .enterprise-brand:hover {
                    background-color: var(--ent-sidebar-hover);
                    color: #FFFFFF;
                }

            .enterprise-brand-name {
                color: #FFFFFF;
                font-size: 1.15rem;
                font-weight: 700;
                letter-spacing: -0.02em;
            }


            /* =========================================================
                       SIDEBAR SECTION TITLE
                       ========================================================= */

            .sidebar-title {
                color: var(--ent-text-light);
                font-size: 0.7rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 1rem 0.75rem 0.5rem;
                font-weight: 700;
            }


            /* =========================================================
                       SIDEBAR LINKS
                       ========================================================= */

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 0.65rem;
                width: 100%;
                color: var(--ent-sidebar-text);
                text-decoration: none;
                padding: 0.65rem 0.75rem;
                border-radius: 0.45rem;
                margin-bottom: 0.25rem;
                font-size: 0.9rem;
                font-weight: 500;
                transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
            }


                .sidebar-link:hover {
                    background-color: var(--ent-sidebar-hover);
                    color: #FFFFFF;
                }


                .sidebar-link.active {
                    background-color: var(--ent-primary);
                    color: #FFFFFF;
                    font-weight: 600;
                    box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
                }


                    .sidebar-link.active:hover {
                        background-color: var(--ent-primary-dark);
                        color: #FFFFFF;
                    }


            /* =========================================================
                       MAIN AREA
                       ========================================================= */

            .enterprise-main {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                width: 100%;
                margin-left: var(--ent-sidebar-width);
                transition: margin-left 0.25s ease;
            }


            /* =========================================================
                       NAVBAR
                       ========================================================= */

            .enterprise-navbar {
                position: sticky;
                top: 0;
                z-index: 1000;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                min-height: var(--ent-navbar-height);
                background-color: var(--ent-surface);
                border-bottom: 1px solid var(--ent-border);
                padding: 0 1.5rem;
            }


            /* =========================================================
                       MOBILE MENU BUTTON
                       ========================================================= */

            .sidebar-toggle {
                display: none;
                width: 38px;
                height: 38px;
                padding: 0;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--ent-border);
                border-radius: 0.45rem;
                background-color: var(--ent-surface);
                color: var(--ent-text);
                font-size: 1.15rem;
            }

                .sidebar-toggle:hover {
                    background-color: var(--ent-surface-alt);
                }


            /* =========================================================
                       USER AREA
                       ========================================================= */

            .enterprise-user-name {
                color: var(--ent-text);
                font-size: 0.9rem;
                font-weight: 600;
            }

            .enterprise-welcome {
                color: var(--ent-text-muted);
                font-size: 0.85rem;
            }


            /* =========================================================
                       CONTENT
                       ========================================================= */

            .enterprise-content {
                flex: 1;
                width: 100%;
                padding: 2rem;
            }


            /* =========================================================
                       FOOTER
                       ========================================================= */

            .enterprise-footer {
                margin-top: auto;
                padding: 1rem 2rem;
                background-color: var(--ent-surface);
                border-top: 1px solid var(--ent-border);
            }

            .enterprise-footer-text {
                color: var(--ent-text-light);
                font-size: 0.8rem;
            }


            /* =========================================================
                       CARDS
                       ========================================================= */

            .card {
                background-color: var(--ent-surface);
                border: 1px solid var(--ent-border) !important;
                border-radius: 0.6rem;
                box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
            }


            /* =========================================================
                       BUTTONS
                       ========================================================= */

            .btn-primary {
                background-color: var(--ent-primary) !important;
                border-color: var(--ent-primary) !important;
                color: #FFFFFF !important;
            }

                .btn-primary:hover {
                    background-color: var(--ent-primary-dark) !important;
                    border-color: var(--ent-primary-dark) !important;
                }


            .btn-outline-secondary {
                color: var(--ent-text-muted);
                border-color: var(--ent-border);
                background-color: var(--ent-surface);
            }

                .btn-outline-secondary:hover {
                    background-color: var(--ent-surface-alt);
                    border-color: var(--ent-border);
                    color: var(--ent-text);
                }


            /* =========================================================
                       FORM CONTROLS
                       ========================================================= */

            .form-control,
            .form-select {
                border-color: var(--ent-border);
                color: var(--ent-text);
            }


                .form-control:focus,
                .form-select:focus {
                    border-color: var(--ent-primary);
                    box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.12);
                }


            /* =========================================================
                       SEMANTIC BADGES
                       ========================================================= */

            .bg-success {
                background-color: var(--ent-success) !important;
            }


            .bg-warning {
                background-color: var(--ent-warning) !important;
                color: #FFFFFF !important;
            }


            .bg-danger {
                background-color: var(--ent-danger) !important;
            }


            .bg-info {
                background-color: var(--ent-info) !important;
            }


            /* =========================================================
                       DROPDOWNS
                       ========================================================= */

            .dropdown-menu {
                border: 1px solid var(--ent-border);
                border-radius: 0.5rem;
                box-shadow: 0 8px 20px rgba(15, 23, 42, 0.1);
            }


            .dropdown-item {
                color: var(--ent-text-muted);
                border-radius: 0.35rem;
            }


                .dropdown-item:hover {
                    background-color: var(--ent-surface-alt);
                    color: var(--ent-text);
                }


            /* =========================================================
                       MOBILE OVERLAY
                       ========================================================= */

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background-color: rgba(15, 23, 42, 0.45);
                z-index: 1040;
                opacity: 0;
                transition: opacity 0.25s ease;
            }


            /* =========================================================
                       RESPONSIVE - TABLET
                       ========================================================= */

            @@media (max-width: 991.98px) {

                :root {
                    --ent-sidebar-width: 230px;
                }

                .enterprise-sidebar {
                    width: var(--ent-sidebar-width);
                }

                .enterprise-main {
                    margin-left: var(--ent-sidebar-width);
                }

                .enterprise-content {
                    padding: 1.5rem;
                }
            }


            /* =========================================================
                       RESPONSIVE - MOBILE
                       ========================================================= */

            @@media (max-width: 767.98px) {

                .enterprise-sidebar {
                    transform: translateX(-100%);
                    width: 260px;
                }


                    .enterprise-sidebar.mobile-open {
                        transform: translateX(0);
                    }


                .enterprise-main {
                    margin-left: 0;
                }


                .enterprise-navbar {
                    justify-content: space-between;
                    padding: 0 1rem;
                }


                .sidebar-toggle {
                    display: inline-flex;
                }


                .sidebar-overlay {
                    display: block;
                    pointer-events: none;
                }


                body.sidebar-open {
                    overflow: hidden;
                }


                    body.sidebar-open .sidebar-overlay {
                        opacity: 1;
                        pointer-events: auto;
                    }


                .enterprise-content {
                    padding: 1.25rem 1rem;
                }


                .enterprise-footer {
                    padding: 1rem;
                }


                .enterprise-welcome {
                    display: none;
                }
            }


            /* =========================================================
                       SMALL MOBILE
                       ========================================================= */

            @@media (max-width: 575.98px) {

                .enterprise-navbar {
                    min-height: 62px;
                }


                .enterprise-content {
                    padding: 1rem 0.75rem;
                }


                .enterprise-user-name {
                    font-size: 0.8rem;
                }


                .enterprise-footer {
                    text-align: center;
                }
            }

    </style>

</head>


<body>

    <div class="enterprise-wrapper">


        <!-- =====================================================
             SIDEBAR
             ===================================================== -->

        <aside id="enterpriseSidebar"
               class="enterprise-sidebar shadow-lg">

            <!-- BRAND -->

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="enterprise-brand">

                <span class="enterprise-brand-name">
                    ShopEasy MVC
                </span>

            </a>


            <!-- PRINCIPAL -->

            <div class="sidebar-title">
                Principal
            </div>


            @{
                var currentController =
                    ViewContext.RouteData.Values["controller"]?.ToString();

                var currentAction =
                    ViewContext.RouteData.Values["action"]?.ToString();
            }


            <!-- DASHBOARD -->

            <a class="sidebar-link @(currentController == "Home" ? "active" : "")"
               asp-controller="Home"
               asp-action="Index">

                <span>📊</span>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- INVENTARIO -->

            <a class="sidebar-link @(currentController == "Products" ? "active" : "")"
               asp-controller="Products"
               asp-action="Index">

                <span>📦</span>

                <span>
                    Inventario
                </span>

            </a>


            <!-- ADMINISTRACIÓN -->
            @if (User.IsInRole("admin"))
            {

                <div class="sidebar-title">
                    Administración
                </div>


                <!-- CATEGORÍAS -->

                <a class="sidebar-link @(currentController == "Categories" ? "active" : "")"
                   asp-controller="Categories"
                   asp-action="Index">

                    <span>📁</span>

                    <span>
                        Categorías
                    </span>

                </a>


                <!-- ÓRDENES -->

                <a class="sidebar-link @(currentController == "Orders" && currentAction != "MyOrders" ? "active" : "")"
                   asp-controller="Orders"
                   asp-action="Index">

                    <span>📋</span>

                    <span>
                        Órdenes
                    </span>

                </a>


                <!-- USUARIOS -->

                <a class="sidebar-link @(currentController == "Users" ? "active" : "")"
                   asp-controller="Users"
                   asp-action="Index">

                    <span>👥</span>

                    <span>
                        Usuarios
                    </span>

                </a>


                <!-- ROLES -->

                <a class="sidebar-link @(currentController == "UserRoles" ? "active" : "")"
                   asp-controller="UserRoles"
                   asp-action="Index">

                    <span>🔐</span>

                    <span>
                        Roles
                    </span>

                </a>

            }


            <!-- CUENTA -->
            @if (User.Identity?.IsAuthenticated == true)
            {

                <div class="sidebar-title">
                    Mi Cuenta
                </div>


                <!-- CARRITO -->

                <a class="sidebar-link @(currentController == "Cart" ? "active" : "")"
                   asp-controller="Cart"
                   asp-action="Index">

                    <span>🛒</span>

                    <span>
                        Carrito
                    </span>

                </a>


                <!-- MIS PEDIDOS -->

                <a class="sidebar-link @(currentController == "Orders" && currentAction == "MyOrders" ? "active" : "")"
                   asp-controller="Orders"
                   asp-action="MyOrders">

                    <span>📦</span>

                    <span>
                        Mis Pedidos
                    </span>

                </a>

            }

        </aside>


        <!-- OVERLAY MOBILE -->

        <div id="sidebarOverlay"
             class="sidebar-overlay">
        </div>


        <!-- =====================================================
             MAIN
             ===================================================== -->

        <div class="enterprise-main">


            <!-- =================================================
                 NAVBAR
                 ================================================= -->

            <header class="enterprise-navbar shadow-sm">


                <!-- MOBILE TOGGLE -->

                <button id="sidebarToggle"
                        type="button"
                        class="sidebar-toggle"
                        aria-label="Abrir menú"
                        aria-expanded="false">

                    ☰

                </button>


                <!-- USER AREA -->

                <div class="d-flex align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <div class="text-end">

                            <div class="enterprise-welcome">
                                Bienvenido
                            </div>

                            <div class="enterprise-user-name">
                                @User.Identity!.Name
                            </div>

                        </div>


                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="m-0">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold">

                                Cerrar Sesión

                            </button>

                        </form>

                    }
                    else
                    {

                        <a class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold"
                           asp-controller="Account"
                           asp-action="Login">

                            Ingresar

                        </a>


                        <a class="btn btn-sm btn-primary rounded-pill px-4 fw-semibold shadow-sm"
                           asp-controller="Account"
                           asp-action="Register">

                            Registrarse

                        </a>

                    }

                </div>

            </header>


            <!-- =================================================
                 CONTENT
                 ================================================= -->

            <main role="main"
                  class="enterprise-content">

                @RenderBody()

            </main>


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <footer class="enterprise-footer">

                <span class="enterprise-footer-text">

                    &copy; 2026 ShopEasy MVC System.
                    Todos los derechos reservados.

                </span>

            </footer>


        </div>

    </div>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    <!-- =========================================================
         SIDEBAR MOBILE
         ========================================================= -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const sidebar =
                    document.getElementById("enterpriseSidebar");

                const toggle =
                    document.getElementById("sidebarToggle");

                const overlay =
                    document.getElementById("sidebarOverlay");

                if (!sidebar || !toggle || !overlay) {
                    return;
                }


                function openSidebar() {

                    sidebar.classList.add("mobile-open");

                    document.body.classList.add("sidebar-open");

                    toggle.setAttribute(
                        "aria-expanded",
                        "true"
                    );

                    toggle.innerHTML = "✕";

                }


                function closeSidebar() {

                    sidebar.classList.remove("mobile-open");

                    document.body.classList.remove("sidebar-open");

                    toggle.setAttribute(
                        "aria-expanded",
                        "false"
                    );

                    toggle.innerHTML = "☰";

                }


                toggle.addEventListener("click", function() {

                    if (sidebar.classList.contains("mobile-open")) {

                        closeSidebar();

                    }
                    else {

                        openSidebar();

                    }

                });


                overlay.addEventListener("click", function() {

                    closeSidebar();

                });


                /* Cerrar sidebar al seleccionar una opción */

                const sidebarLinks =
                    sidebar.querySelectorAll(".sidebar-link");

                sidebarLinks.forEach(function(link) {

                    link.addEventListener("click", function() {

                        if (window.innerWidth <= 767) {

                            closeSidebar();

                        }

                    });

                });


                /* Cerrar al volver a escritorio */

                window.addEventListener("resize", function() {

                    if (window.innerWidth > 767) {

                        closeSidebar();

                    }

                });

            });

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>