@using ShopEasyMVC.Helpers
@model ShopEasyMVC.Models.Order

@{
    ViewData["Title"] = "Detalle de pedido";
}

<h1>Detalle de pedido</h1>

<dl class="row">
    <dt class="col-sm-2">Número</dt>
    <dd class="col-sm-10">@Model.OrderNumber</dd>

    <dt class="col-sm-2">Total</dt>
    <dd class="col-sm-10">@Model.TotalAmount.ToColones()</dd>

    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10"><span class="badge @Model.Status.ToBadgeClass()">@Model.Status.GetDisplayName()</span></dd>

    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-2">Dirección de envío</dt>
    <dd class="col-sm-10">@Model.ShippingAddress</dd>

    <dt class="col-sm-2">Método de pago</dt>
    <dd class="col-sm-10">@Model.PaymentMethod.GetDisplayName()</dd>
</dl>

<h4>Productos</h4>

<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToColones()</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="MyOrders" class="btn btn-secondary">Volver</a>
