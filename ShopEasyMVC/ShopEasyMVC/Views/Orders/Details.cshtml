@using ShopEasyMVC.Helpers
@model ShopEasyMVC.Models.Order

@{
    ViewData["Title"] = "Detalles de orden";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Detalles de Orden
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Información completa de la orden seleccionada.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary shadow-sm px-4 rounded-pill fw-semibold">
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
                Volver
            </a>

        </div>

    </div>


    <!-- DETALLE -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center gap-2 mb-3">

                <h2 class="h5 fw-bold mb-0 section-title">
                    @Model.OrderNumber
                </h2>

                <span class="badge @Model.Status.ToBadgeClass()">
                    @Model.Status.GetDisplayName()
                </span>

            </div>

            <dl class="row product-detail-dl mb-0">

                <dt class="col-sm-3 enterprise-label mb-2">Total</dt>
                <dd class="col-sm-9 mb-2">@Model.TotalAmount.ToColones()</dd>

                <dt class="col-sm-3 enterprise-label mb-2">Usuario</dt>
                <dd class="col-sm-9 mb-2">@Model.User.FullName (@Model.User.Email)</dd>

                <dt class="col-sm-3 enterprise-label mb-0">Fecha</dt>
                <dd class="col-sm-9 mb-0">@Html.DisplayFor(model => model.CreatedAt)</dd>

            </dl>

        </div>

    </div>


    <!-- PRODUCTOS EN LA ORDEN -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-0">

            <div class="inventory-table-header">

                <div>
                    <h2 class="h6 fw-bold mb-1 section-title">
                        Productos en la orden
                    </h2>

                    <p class="small mb-0 section-subtitle">
                        @Model.OrderItems.Count producto(s) en esta orden.
                    </p>
                </div>

            </div>

            <div class="table-responsive">

                <table class="table enterprise-table align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4">
                                Producto
                            </th>

                            <th>
                                Cantidad
                            </th>

                            <th class="pe-4">
                                Precio unitario
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>

                                <td class="ps-4">
                                    <div class="product-name">
                                        @item.Product.Name
                                    </div>
                                </td>

                                <td>
                                    <span class="stock-value">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td class="pe-4">
                                    <span class="product-price">
                                        @item.UnitPrice.ToColones()
                                    </span>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ACCIONES -->
    <div class="d-flex gap-2">

        <a asp-controller="OrderItems" asp-action="Create"
           class="btn btn-primary fw-semibold px-4 rounded-pill">
            Agregar producto
        </a>

    </div>

</div>

@section Scripts {

    <style>

        .product-detail-dl dt {
            color: var(--ent-text-muted);
            font-size: 0.82rem;
            font-weight: 600;
        }

        .product-detail-dl dd {
            color: var(--ent-text);
            font-size: 0.9rem;
            font-weight: 600;
        }

    </style>

}