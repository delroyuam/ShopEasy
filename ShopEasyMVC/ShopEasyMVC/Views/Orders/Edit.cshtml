@model ShopEasyMVC.Models.Order

@{
    ViewData["Title"] = "Editar orden";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Editar Orden
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Modifica la información de la orden seleccionada.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
            Volver
        </a>

    </div>


    <!-- FORMULARIO -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div>
                    <h2 class="h6 fw-bold mb-1 section-title">
                        Información de la orden
                    </h2>

                    <p class="small mb-0 section-subtitle">
                        Actualiza los campos necesarios y guarda los cambios.
                    </p>
                </div>

            </div>

            <form asp-action="Edit" method="post" class="row g-3">

                <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
                <input type="hidden" asp-for="Id" />

                <!-- NÚMERO DE ORDEN -->
                <div class="col-12 col-md-6">

                    <label asp-for="OrderNumber" class="form-label enterprise-label">
                        Número de orden
                    </label>

                    <input asp-for="OrderNumber" class="form-control enterprise-input" readonly />
                    <small class="form-text section-subtitle">El número de orden no se puede modificar.</small>
                    <span asp-validation-for="OrderNumber" class="text-danger"></span>

                </div>


                <!-- TOTAL -->
                <div class="col-12 col-md-6">

                    <label asp-for="TotalAmount" class="form-label enterprise-label">
                        Total
                    </label>

                    <div class="input-group">

                        <span class="input-group-text enterprise-input-icon">
                            ₡
                        </span>

                        <input asp-for="TotalAmount" class="form-control enterprise-input" />

                    </div>
                    <span asp-validation-for="TotalAmount" class="text-danger"></span>

                </div>


                <!-- ESTADO -->
                <div class="col-12 col-md-6">

                    <label asp-for="Status" class="form-label enterprise-label">
                        Estado
                    </label>

                    <select asp-for="Status" class="form-select enterprise-input" asp-items="ViewBag.Status"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>

                </div>


                <!-- FECHA -->
                <div class="col-12 col-md-6">

                    <label asp-for="CreatedAt" class="form-label enterprise-label">
                        Fecha
                    </label>

                    <input asp-for="CreatedAt" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control enterprise-input" />
                    <span asp-validation-for="CreatedAt" class="text-danger"></span>

                </div>


                <!-- USUARIO -->
                <div class="col-12">

                    <label asp-for="UserId" class="form-label enterprise-label">
                        Usuario
                    </label>

                    <select asp-for="UserId" class="form-select enterprise-input" asp-items="ViewBag.UserId">
                        <option value="">Seleccione un usuario</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>

                </div>


                <!-- BOTONES -->
                <div class="col-12 d-flex gap-2 mt-4">

                    <input type="submit" value="Guardar cambios" class="btn btn-primary fw-semibold px-4 rounded-pill" />

                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 rounded-pill">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}