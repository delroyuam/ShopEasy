@model ShopEasyMVC.Models.UserRole

@{
    ViewData["Title"] = "Eliminar rol";
}

<h1>Eliminar rol</h1>

<h3>¿Seguro que desea eliminar este rol?</h3>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Rol</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>

        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@Model.User.FullName (@Model.User.Email)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Eliminar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div>
