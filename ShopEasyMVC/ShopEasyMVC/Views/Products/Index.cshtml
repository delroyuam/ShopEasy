@model IEnumerable<ShopEasyMVC.Models.Product>

@{
    ViewData["Title"] = "Gestión de Inventario";
    var search = ViewData["Search"] as string;
    var stockFilter = ViewData["StockFilter"] as string;
    var lowStockThreshold = (int)(ViewData["LowStockThreshold"] ?? 5);
}

<h1>Gestión de Inventario</h1>
<p class="text-muted">Panel de administración de productos (RF-008).</p>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label for="search" class="form-label mb-1">Buscar por nombre</label>
        <input type="text" name="search" id="search" value="@search" class="form-control" placeholder="Nombre del producto" />
    </div>
    <div class="col-md-3">
        <label for="categoryId" class="form-label mb-1">Categoría</label>
        <select name="categoryId" id="categoryId" class="form-select" asp-items="ViewBag.CategoryId">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="col-md-3">
        <label for="stock" class="form-label mb-1">Disponibilidad</label>
        <select name="stock" id="stock" class="form-select">
            <option value="">Todas</option>
            <option value="in" selected="@(stockFilter == "in")">En stock</option>
            <option value="low" selected="@(stockFilter == "low")">Stock bajo</option>
            <option value="out" selected="@(stockFilter == "out")">Agotado</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear producto</a>
</p>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>Imagen</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Disponibilidad</th>
            <th>Activo</th>
            <th>Categoría</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Name"
                             style="width:48px;height:48px;object-fit:cover;cursor:pointer;"
                             class="rounded product-thumb"
                             data-bs-toggle="modal" data-bs-target="#imageModal"
                             data-img-src="@item.ImageUrl" data-img-alt="@item.Name" />
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td>@item.Name</td>
                <td>@item.CurrentPrice.ToColones()</td>
                <td>@item.Stock</td>
                <td>
                    @if (item.Stock == 0)
                    {
                        <span class="badge bg-danger">Agotado</span>
                    }
                    else if (item.Stock <= lowStockThreshold)
                    {
                        <span class="badge bg-warning text-dark">Stock bajo</span>
                    }
                    else
                    {
                        <span class="badge bg-success">En stock</span>
                    }
                </td>
                <td>@(item.IsActive ? "Sí" : "No")</td>
                <td>@item.Category.Name</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay productos que coincidan con los filtros seleccionados.</div>
}

<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center p-0">
                <img id="imageModalImg" src="" alt="" class="img-fluid rounded" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/image-modal.js" asp-append-version="true"></script>
}
