@model ShopEasyMVC.Models.Product

@{
    ViewData["Title"] = "Crear producto";
}

<div class="inventory-page">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 mb-0 fw-bold page-title">
                    Crear Producto
                </h1>
            </div>

            <p class="mb-0 page-subtitle">
                Completa la información para registrar un nuevo producto.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary shadow-sm px-4 rounded-pill fw-semibold">
            Volver
        </a>

    </div>


    <!-- FORMULARIO -->
    <div class="card enterprise-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex align-items-center mb-3">

                <div>
                    <h2 class="h6 fw-bold mb-1 section-title">
                        Información del producto
                    </h2>

                    <p class="small mb-0 section-subtitle">
                        Todos los campos marcados son requeridos para completar el registro.
                    </p>
                </div>

            </div>

            <form asp-action="Create" method="post" class="row g-3">

                <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

                <!-- NOMBRE -->
                <div class="col-12 col-md-6">

                    <label asp-for="Name" class="form-label enterprise-label">
                        Nombre
                    </label>

                    <input asp-for="Name" class="form-control enterprise-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>

                </div>


                <!-- CATEGORÍA -->
                <div class="col-12 col-md-6">

                    <label asp-for="CategoryId" class="form-label enterprise-label">
                        Categoría
                    </label>

                    <select asp-for="CategoryId" class="form-select enterprise-input" asp-items="ViewBag.CategoryId">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>

                </div>


                <!-- DESCRIPCIÓN -->
                <div class="col-12">

                    <label asp-for="Description" class="form-label enterprise-label">
                        Descripción
                    </label>

                    <input asp-for="Description" class="form-control enterprise-input" />
                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>


                <!-- PRECIO -->
                <div class="col-12 col-md-4">

                    <label asp-for="CurrentPrice" class="form-label enterprise-label">
                        Precio
                    </label>

                    <div class="input-group">

                        <span class="input-group-text enterprise-input-icon">
                            ₡
                        </span>

                        <input asp-for="CurrentPrice" class="form-control enterprise-input" />

                    </div>
                    <span asp-validation-for="CurrentPrice" class="text-danger"></span>

                </div>


                <!-- STOCK -->
                <div class="col-12 col-md-4">

                    <label asp-for="Stock" class="form-label enterprise-label">
                        Stock
                    </label>

                    <input asp-for="Stock" class="form-control enterprise-input" />
                    <span asp-validation-for="Stock" class="text-danger"></span>

                </div>


                <!-- ACTIVO -->
                <div class="col-12 col-md-4">

                    <label class="form-label enterprise-label d-block">
                        Estado
                    </label>

                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label enterprise-label mb-0">
                            Activo
                        </label>
                    </div>

                </div>


                <!-- URL DE IMAGEN -->
                <div class="col-12">

                    <label asp-for="ImageUrl" class="form-label enterprise-label">
                        URL de imagen
                    </label>

                    <div class="input-group">

                        <span class="input-group-text enterprise-input-icon">
                            🖼️
                        </span>

                        <input asp-for="ImageUrl" class="form-control enterprise-input" />

                    </div>
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>

                </div>


                <!-- BOTONES -->
                <div class="col-12 d-flex gap-2 mt-4">

                    <input type="submit" value="Crear producto" class="btn btn-primary fw-semibold px-4 rounded-pill" />

                    <a asp-action="Index" class="btn btn-outline-secondary fw-semibold px-4 rounded-pill">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}