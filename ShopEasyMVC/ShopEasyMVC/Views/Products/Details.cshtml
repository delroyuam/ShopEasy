@model ShopEasyMVC.Models.Product

@{
    ViewData["Title"] = "Detalles de producto";
}

<h1>Detalles de producto</h1>

<hr />

<dl class="row">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">
            <img src="@Model.ImageUrl" alt="@Model.Name"
                 style="width:140px;height:140px;object-fit:cover;cursor:pointer;"
                 class="rounded product-thumb"
                 data-bs-toggle="modal" data-bs-target="#imageModal"
                 data-img-src="@Model.ImageUrl" data-img-alt="@Model.Name" />
        </dd>
    }

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>

    <dt class="col-sm-2">Precio</dt>
    <dd class="col-sm-10">@Model.CurrentPrice.ToColones()</dd>

    <dt class="col-sm-2">Stock</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Stock)</dd>

    <dt class="col-sm-2">Activo</dt>
    <dd class="col-sm-10">@(Model.IsActive ? "Sí" : "No")</dd>

    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.Category.Name</dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedAtUtc)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>

<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-body text-center p-0">
                <img id="imageModalImg" src="" alt="" class="img-fluid rounded" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/image-modal.js" asp-append-version="true"></script>
}
