@model ShopEasyMVC.Models.Product

@{
    ViewData["Title"] = "Detalles de producto";
}

<h1>Detalles de producto</h1>

<hr />

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Name)</dd>

    <dt class="col-sm-2">Descripción</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Description)</dd>

    <dt class="col-sm-2">Precio</dt>
    <dd class="col-sm-10">@Model.CurrentPrice.ToString("C")</dd>

    <dt class="col-sm-2">Stock</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Stock)</dd>

    <dt class="col-sm-2">Activo</dt>
    <dd class="col-sm-10">@(Model.IsActive ? "Sí" : "No")</dd>

    <dt class="col-sm-2">Categoría</dt>
    <dd class="col-sm-10">@Model.Category.Name</dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedAtUtc)</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
